# Logs
logs
!src/pages/logs/
!src/pages/logs/*.tsx
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# 包管理器统一使用 bun；禁止 pnpm-lock 漂移
pnpm-lock.yaml
playwright-report
test-results
# E2E 本地场景清单含真实 ID，禁止入库（example.json 已提交作模板）
tests/e2e/fixtures/*.local.json

# TypeScript incremental build cache (regenerated by tsc)
*.tsbuildinfo

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
# .env.production 入仓：仅含占位符 __IMBOY_API_HOST__，无真实凭证
# （CI 构建需要此文件让 Vite 把占位符 bake 进产物，entrypoint 再运行时替换）
# Local automation scripts with hardcoded prod credentials — never commit
prod_login*.mjs
.env.e2e
.env
.env.local
.env.*.local

# Erlang Common Test artifacts (from adjacent imboy backend)
_build

# Erlang 编译产物（误入前端仓防护）
*.beam

# Playwright E2E 自动证据副产物（截图/JSON，不入库）
tests/auto_test/evidence/

# Claude local-scope 本机配置不入库（共享配置为 tracked 的 .claude/settings.json）
.claude/settings.local.json
