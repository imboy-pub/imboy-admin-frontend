{
  // Q10 / AC24：Admin 仓 Knip 入口模型（2026-10-07，一期交付收敛计划）。
  // 本文件是 knip 唯一配置源；package.json 不再保留 knip 段（避免双源合并歧义）。
  // 原则：先建模后删码——本模型只声明"真实入口"，不整目录静默 ignore；
  // 每个 entry/ignore 逐条写明理由，处置变更须同步更新本注释。
  // 注：knip 不解析 HTML <script src>，故 seat/widget 的 HTML 入口以
  // 其引用的 TS 模块直接声明（引用链见各条注释）。
  //
  // —— G15 豁免与待裁决登记（2026-10-07，ADM-Q07-G15 批；owner=Q10-owner，
  //    复核期限=二期启动时；本批只撤 export、不做删除——批5教训）——
  // [豁免·生成物] src/generated/generatedFeatureComposition.tsx 的
  //   adminFeatureCompositionManifestHash / adminFeatureCompositionSchemaVersion /
  //   adminFeatureCompositionFeatures：生成文件（生成器产物，sha 入 G03 门），
  //   不可手改；其导出面由生成器合同定义。
  // [豁免·模块边界] src/modules/channels/public.ts 的 7 个页面转发
  //   （ChannelDetailPage/ChannelMessagePage/ChannelSubscriberPage/ChannelAdminPage/
  //   ChannelInvitationPage/ChannelOrderPage/PaidChannelOpsPage）与
  //   src/modules/channels/api/public.ts 的 9 个 getXxx/searchChannels：
  //   设计声明的 channels 模块公共 API 面（批4 结论"转发死码不动"），消费方
  //   当前直接路径 import 属边界内合法形态，二期随 channels 域裁决。
  // [豁免·惯例导出] OrganizationWorkspacePicker 的 default 导出：组件文件
  //   named+default 双导出惯例，本期不动。
  // [待裁决·撤不得] 以下 unused exports 无本文件使用，撤 export 会暴露死值
  //   触发 eslint no-unused-vars；删除批本 run 禁做（批5：合同误报占大头），
  //   留二期逐项裁决：hosted helpers/env.ts SHOP2/INST_B；
  //   customer_service pureFunctions CS_SEAT_SAFE_KEYS/CS_SESSION_SAFE_KEYS/
  //   CS_SESSION_STATUS_FILTERS；workbench/contract SEAT_ATTACHMENT_PHASES
  //   （仅 type 派生，处置需转纯类型）；enterprise_apps contracts SECRET_ONCE_FIELD、
  //   pureFunctions sensitivityOf；enterprise_business pureFunctions
  //   EB_OFFBOARDING_STATUS_FILTERS；services/api/mcpGovernance createClient；
  //   p2 helpers/db-proof pruneSeatEventsBelow/sessionRatingPresent、env SEAT_A/SEAT_B；
  //   real helpers/db-proof latestVisitTokenId/revokeVisitTokenRow。
  "$schema": "https://unpkg.com/knip@6.7.0/schema.json",
  "entry": [
    // —— vite 构建产物入口（见 vite.config.ts widgetBuildOverrides）——
    // Admin SPA 默认入口：dev/build（mode production）；
    // index.html → src/main.tsx（knip vite 插件已识别，无需重复声明）
    // build:widget 链 seat 模式：seat/index.html <script> 引用本模块，
    // 产物 dist-widget/seat/index.html，由后端 /seat/:id frame 面同源引用
    "src/seat/seatMain.tsx",
    // build:widget 链 widget 模式：widget/index.html <script> 引用本模块，
    // iframe 聊天应用，产物 dist-widget/widget/index.html
    "src/widget/customer_service/app/main.ts",
    // build:widget 链 widget-loader 模式：vite lib.entry 为字符串引用
    // （vite.config.ts），knip 无法静态解析；产物 dist-widget/loader.js
    // 是宿主 snippet 的稳定入口（冻结合同 v1 S6）
    "src/widget/customer_service/loader.ts",

    // —— Playwright 套件配置入口 ——
    // 默认名 playwright.config.ts 与 package.json scripts 挂载的 3 个 config
    // （prod-check/real/p2）由 knip playwright 插件自动识别，无需声明。
    // 以下 3 个未被 scripts 挂载且非默认命名，仅经 tests/*/README.md 与
    // fixtures/harness*.sh 以 `bunx playwright test -c <config>` 手动运行：
    // hosted：第三方托管面（nginx TLS + 真实 dist-widget 产物）
    "playwright.customer-service-hosted.config.ts",
    // int03：INT02 目录 a08/a09/a09b 专属 config（testDir=tests/e2e/customer-service-int02）
    "playwright.customer-service-int03.config.ts",
    // seat-embed：坐席嵌入面（SC153 系列）
    "playwright.customer-service-seat-embed.config.ts",
    // 全部 spec 为各套件 testDir 的叶子入口（含被主 config testIgnore 的
    // 专属目录与 enterprise-ent-int01，它们经专属 config 或单文件运行）
    "tests/e2e/**/*.spec.ts",

    // —— 测试与 QA 工具入口（手动 CLI，无静态引用方）——
    // node --test 直跑入口（bunfig.toml [test] root=./src 不覆盖 scripts/，
    // 用法见 docs/qa/customer-service-real-static-host-2026-10-01.md）
    "scripts/test/*.test.mjs",
    // E2E 独立后端编排 CLI（bun scripts/e2e-backend.mts db/start/seed/…，
    // 用法在文件头注释；给 test:e2e 提供隔离 scratch DB 后端）
    "scripts/e2e-backend.mts",
    // P1-E2E-01 A05 取证工具（node residual-check.mjs <output.json>，
    // 残留检查/密钥扫描；admin-local-gates-2026-10-02 证据链使用，
    // 后续交付验收（AC28）复用，保留工具入口）
    "tests/e2e/customer-service-real/scripts/*.mjs",
    "tests/e2e/customer-service-p2/scripts/*.mjs"
  ],
  "ignore": [
    // —— 被字符串命令/env var/alias 动态调用的文件（knip 无法静态解析）——
    // react-router-dom 纯 <a> 替身：seat 构建模式经 vite resolve.alias 字符串
    // 映射进入 rollup 图（vite.config.ts）；替身契约要求同时提供 named 与
    // default 双导出（镜像 react-router-dom Link），duplicate export 报告
    // 属替身契约噪声；缺失导出由 rollup 构建期报错兜底
    "src/seat/routerStub.tsx",
    // 情景清单校验 CLI（node tests/e2e/scripts/check_scenario_manifest.mjs
    // [--strict] <manifest.json>），被 imboy 仓 QA gate 证据流程按路径调用；
    // 沿用既有 ignore（Q10 前已在 package.json 声明）
    "tests/e2e/scripts/**",
    // 静态托管面服务器：playwright.customer-service-{real,p2}.config.ts 的
    // webServer.command 以 `node <path>` 字符串启动（真实网络栈依赖），
    // spec 内亦以 path.join 动态拼接路径引用（a02/a03）
    "tests/e2e/customer-service-real/helpers/static-host.mjs",
    "tests/e2e/customer-service-p2/helpers/static-host-p2.mjs",
    // 浏览器旅程 runner：被 imboy 仓 QA 文档（docs/qa/customer-service-*-browser-*.md）
    // 经 IMBOY_CS_BROWSER_RUNNER 环境变量按路径动态调用（跨仓 harness 约定）
    "scripts/test/customer-service-browser-journey.mjs"
  ],
  "ignoreUnresolved": [
    // int02 spec（a09b-attachments-real.spec.ts）在 page.evaluate 内经浏览器
    // 运行时动态字符串 import('/src/...seatAuthStore.ts') 注入坐席会话，
    // 是真实动态引用而非解析错误；按 knip 官方 ignoreUnresolved
    // （specifier 匹配，支持正则）豁免
    "^/src/modules/customer_service/seat/seatAuthStore\\.ts$"
  ]
}
